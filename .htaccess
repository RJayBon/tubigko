# Deny access to sensitive files
<FilesMatch "\.(sql|log|md|ini|env|json|lock)$">
    Require all denied
</FilesMatch>

# Deny access to dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Default charset
AddDefaultCharset UTF-8

# Pretty error pages (optional)
# ErrorDocument 403 /tubigko/index.php